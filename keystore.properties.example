# Keystore Configuration for GECE IPTV Release Builds
# Bu dosyanin bir kopyasini 'keystore.properties' olarak kaydedip sifrenizi yazin.
# 'keystore.properties' dosyasi .gitignore'a eklenmistir, sifreniz asla GitHub'a gitmez.

storeFile=release.jks
storePassword=BURAYA_KEYSTORE_SIFRENIZI_YAZIN
keyAlias=geceiptv
keyPassword=BURAYA_KEYSTORE_SIFRENIZI_YAZIN
